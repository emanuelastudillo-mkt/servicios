{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "d2cdef3f9ea09724bea15ce392e12016",
  "name": "apex1000-online",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apex1000-online",
      "database_id": "f470cfe4-4ce6-40d3-b0d6-101a6468b21c",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RaceRoom" }],
  },
  "migrations": [
    { "tag": "v1-room-events", "new_sqlite_classes": ["RaceRoom"] },
  ],
  "triggers": { "crons": ["0 0 * * *"] },
  "ratelimits": [
    {
      "name": "COMMAND_LIMIT",
      "namespace_id": "10001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "SEASON_EPOCH": "2026-10-07T03:00:00Z",
    "MAX_PLAYERS": "20",
    "RP_ID": "emanuelmkt.com.ar",
    "AUTH_ORIGINS": "https://emanuelmkt.com.ar",
    "MAX_TICK_SECONDS": "60",
    "ALLOWED_ORIGINS": "https://emanuelmkt.com.ar",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
