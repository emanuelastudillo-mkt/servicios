{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex1000-online",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apex1000-online",
      "database_id": "REEMPLAZAR_CON_ID_DE_D1",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [
    {
      "name": "COMMAND_LIMIT",
      "namespace_id": "10001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "SEASON_EPOCH": "2026-10-07T03:00:00Z",
    "MAX_PLAYERS": "20",
  },
  "limits": { "cpu_ms": 30000 },
}
